[Desktop Entry]
Name=Herb's Terminal
Comment=A terminal for administrators, with an SSH-aware file explorer
Exec=herbs-terminal
Icon=org.herbsterminal.app
Terminal=false
Type=Application
Categories=System;TerminalEmulator;
Keywords=shell;ssh;sftp;terminal;console;command;prompt;
StartupNotify=true
StartupWMClass=org.herbsterminal.app
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=herbs-terminal
